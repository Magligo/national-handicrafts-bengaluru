{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/products",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=86400, stale-if-error=86400"
        }
      ]
    },
    {
      "source": "/((?!api(?:/|$)|.*\\.[^/]+$).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://national-handicrafts-bengaluru.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
